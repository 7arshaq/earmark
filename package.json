{
  "name": "earmark",
  "version": "1.0.0",
  "private": true,
  "description": "Paste a video link, keep the audio, listen like a podcast. Installable PWA + tiny yt-dlp server.",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "demo": "node scripts/demo.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/onest": "^5.1.0",
    "@resvg/resvg-js": "^2.6.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
